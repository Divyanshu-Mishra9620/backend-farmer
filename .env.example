PORT=3000
NODE_ENV=development

DATABASE_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

EMAIL_USER=
EMAIL_PASS=

# Comma-separated OAuth 2.0 Client IDs from Google Cloud Console — one each
# for Web, iOS, and Android, all under the same project/consent screen.
# Used as the accepted audience list when verifying Google ID tokens.
GOOGLE_CLIENT_IDS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
DEEPGRAM_API_KEY=

OPENWEATHER_API_KEY=
OPENCAGE_API_KEY=
MARKET_API_URL=
MARKET_API_KEY=

# RAG service (Retrieval aug gen/rag) base URL — used to route photo-based
# disease diagnosis (hardware captures and the direct-upload endpoint) through
# its grounded ML-classifier + knowledge-base pipeline instead of inventing a
# diagnosis with a raw vision-LLM call. Calls are authenticated with a
# short-lived JWT this backend mints itself, using the SAME JWT_SECRET the RAG
# service verifies with (see rag/app/core/security.py) — no separate key needed.
RAG_API_URL=

MAX_UPLOAD_SIZE=5242880

# Optional: Expo's "Enhanced Push Security" access token for sending push
# notifications. Not required for basic push sending.
EXPO_ACCESS_TOKEN=
# Cron schedule for the weather-alert sweep (default: every 3 hours)
WEATHER_ALERT_CRON=0 */3 * * *

# Optional HMAC pepper for hashing field-device keys. Stored hashes depend on
# it, so setting or changing it on a running deployment invalidates every
# issued device key — each board must then be re-registered or have its key
# rotated from the dashboard.
DEVICE_KEY_PEPPER=
# A device that has not reported for this long is shown as offline
DEVICE_OFFLINE_AFTER_S=900
# TTL on stored sensor readings; 0 disables expiry and keeps them forever
TELEMETRY_RETENTION_DAYS=30
# Most readings a gateway may flush in one POST /api/telemetry/readings
TELEMETRY_MAX_BATCH=50
# Minimum gap before re-pushing an Expo notification for the same (device,
# alert kind) — stops a persistently dry/hot/low-battery reading from pushing
# on every ~5min ingest cycle it survives
TELEMETRY_ALERT_PUSH_COOLDOWN_S=14400
# How often to sweep for devices that have gone silent (device_offline can't
# originate from an ingest — nothing arrives to trigger it — so this polls
# instead)
DEVICE_OFFLINE_CHECK_CRON=*/5 * * * *

# --- Sprinkler / actuator command queue -------------------------------------
# See hardware/docs/API_CONTRACT.md section 8 for the full safety model.
#
# A queued command no gateway has collected within this window expires instead
# of being delivered. This is the interlock that matters most: a gateway that
# drops off WiFi mid-afternoon must not come back at dusk and run a spray the
# farmer authorised hours ago for conditions that no longer exist. Keep it near
# the reading interval, not far above it.
ACTUATOR_COMMAND_TTL_S=180
# Hard ceiling on one run, enforced here AND again by a firmware watchdog that
# cuts the relay on a local timer. Two independent limits, because a valve stuck
# open is the failure that floods a plot.
ACTUATOR_MAX_RUNTIME_S=120
# Minimum gap between two runs on one device, so repeated taps (or a flapping
# detection) cannot waterlog the root zone.
ACTUATOR_COOLDOWN_S=900
# Total relay-on seconds allowed per device per rolling 24 h.
ACTUATOR_DAILY_BUDGET_S=600
